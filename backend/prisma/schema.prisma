generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 사용자
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("member") // admin | member
  createdAt DateTime @default(now()) @map("created_at")

  members        Member[]
  assigned       Issue[]         @relation("assignee")
  todos          Todo[]
  aiTools        AiTool[]
  skillProgresses SkillProgress[]
  dailyMottos    DailyMotto[]
  calendarEvents CalendarEvent[]
  moods          Mood[]
  workouts       Workout[]
  meals          Meal[]

  @@map("users")
}

// 프로젝트
model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String   @default("active") // active | done | hold
  createdAt   DateTime @default(now()) @map("created_at")

  members Member[]
  issues  Issue[]

  @@map("projects")
}

// 프로젝트 멤버
model Member {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  role      String   @default("dev") // owner | dev | viewer
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("members")
}

// 이슈
model Issue {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  assigneeId Int?     @map("assignee_id")
  title       String
  description String?
  status      String   @default("todo") // todo | doing | done
  priority    String   @default("mid")  // high | mid | low
  urgency     String   @default("normal") // urgent | high | normal | low
  requestedAt DateTime? @map("requested_at")
  dueAt       DateTime? @map("due_at")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("issues")
}

// 개인 할일
model Todo {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(500)
  done      Boolean  @default(false)
  dueDate   DateTime? @map("due_date")
  memo      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  files TodoFile[]

  @@map("todos")
}

// 할일 첨부파일
model TodoFile {
  id        Int      @id @default(autoincrement())
  todoId    Int      @map("todo_id")
  filename  String   @db.VarChar(255)
  path      String   @db.VarChar(500)
  mimetype  String   @db.VarChar(100)
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@map("todo_files")
}

// AI 도구 가이드
model AiTool {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  content     String   @db.Text
  tags        String[]
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  authorId    Int      @map("author_id")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("ai_tools")
}

// 역량확장 레벨
model SkillLevel {
  id          Int      @id @default(autoincrement())
  order       Int      @unique
  title       String
  description String
  icon        String   @default("📚")
  content     String   @db.Text
  challenge   String?  @db.Text  // 퀴즈/챌린지 JSON
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  progresses SkillProgress[]

  @@map("skill_levels")
}

// 역량확장 진행률
model SkillProgress {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  levelId     Int       @map("level_id")
  status      String    @default("locked") // locked | in_progress | completed
  score       Int?
  note        String?   @db.Text
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  level SkillLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@map("skill_progresses")
}

// 오늘의 각오
model DailyMotto {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  content   String   @db.VarChar(200)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_mottos")
}

// 개인 캘린더 일정
model CalendarEvent {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(200)
  date      DateTime @db.Date
  startTime String?  @map("start_time") @db.VarChar(5)
  endTime   String?  @map("end_time") @db.VarChar(5)
  memo      String?  @db.Text
  location  String?  @db.VarChar(200)
  color     String   @default("#3b82f6") @db.VarChar(7)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

// 주식 뉴스 AI 분류 캐시
model StockNews {
  id          Int      @id @default(autoincrement())
  stockCode   String   @map("stock_code") @db.VarChar(10)
  stockName   String   @map("stock_name") @db.VarChar(50)
  title       String   @db.VarChar(300)
  summary     String   @db.VarChar(50)
  importance  String   @db.VarChar(10)
  sentiment   String   @default("neutral") @db.VarChar(10)
  reason      String   @db.VarChar(200)
  explain     String?  @db.Text
  url         String   @db.VarChar(500)
  publishedAt DateTime @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([stockCode, publishedAt])
  @@map("stock_news")
}

model StockNewsCacheLog {
  id        Int      @id @default(autoincrement())
  stockCode String   @unique @map("stock_code") @db.VarChar(10)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("stock_news_cache_log")
}

// 기분 트래커
model Mood {
  id        String   @id @default(uuid())
  date      String   // 'YYYY-MM-DD'
  mood      Int      // 1-5
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("moods")
}

// 운동 트래커
model Workout {
  id        String   @id @default(uuid())
  date      String
  name      String
  weight    Float?
  sets      Int?
  reps      Int?
  duration  Int?
  memo      String?
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workouts")
}

// 식사 트래커
model Meal {
  id        String   @id @default(uuid())
  date      String
  type      String
  content   String
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meals")
}
