generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 사용자
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("member") // admin | member
  createdAt DateTime @default(now()) @map("created_at")

  members        Member[]
  assigned       Issue[]         @relation("assignee")
  todos          Todo[]
  aiTools        AiTool[]
  dailyMottos    DailyMotto[]
  calendarEvents CalendarEvent[]
  moods          Mood[]
  workouts       Workout[]
  meals          Meal[]
  memos             Memo[]
  tradeLogs         TradeLog[]
  techNotes         TechNote[]
  issueComments     IssueComment[]
  kakaoToken        KakaoToken?
  marketJournals    MarketJournal[]
  scoreSnapshots    ScoreSnapshot[]
  scorePortfolio    ScorePortfolio?
  preference        UserPreference?
  movieBookmarks    MovieBookmark[]

  @@map("users")
}

// 프로젝트
model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String   @default("active") // active | done | hold
  order       Int      @default(0)
  externalUrl String?  @map("external_url") @db.Text  // 외부 링크 (구글 스프레드시트 등)
  createdAt   DateTime @default(now()) @map("created_at")

  members Member[]
  issues  Issue[]

  @@map("projects")
}

// 프로젝트 멤버
model Member {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  role      String   @default("dev") // owner | dev | viewer
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("members")
}

// 이슈
model Issue {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  assigneeId Int?     @map("assignee_id")
  title       String
  description String?
  status      String   @default("todo") // todo | doing | confirm | done
  priority    String   @default("mid")  // high | mid | low
  urgency     String   @default("normal") // urgent | high | normal | low
  category    String   @default("improvement") @db.VarChar(20) // bug | improvement | question
  module      String   @default("개인성과") @db.VarChar(30)     // 개인성과 | 업무 | 인사평가
  externalId  String?  @map("external_id") @db.VarChar(20)    // 엑셀 관리 번호
  requestedAt DateTime? @map("requested_at")
  dueAt       DateTime? @map("due_at")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments IssueComment[]
  files    IssueFile[]

  @@map("issues")
}

// 이슈 첨부파일
model IssueFile {
  id        Int      @id @default(autoincrement())
  issueId   Int      @map("issue_id")
  filename  String   @db.VarChar(255)
  path      String   @db.VarChar(500)
  mimetype  String   @db.VarChar(100)
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("issue_files")
}

// 개인 할일
model Todo {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(500)
  done      Boolean  @default(false)
  dueDate   DateTime? @map("due_date")
  memo      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  repeatType  String?   @map("repeat_type")   // 'none' | 'daily' | 'weekly' | 'monthly'
  repeatDay   Int?      @map("repeat_day")    // weekly: 요일(0=일~6=토), monthly: 날짜(1~31)
  startDate   DateTime? @map("start_date")            // 시작일 (없으면 dueDate 단일 날짜)
  startTime   String?   @map("start_time") @db.VarChar(5) // "HH:mm"
  endTime     String?   @map("end_time")   @db.VarChar(5) // "HH:mm"
  allDay      Boolean   @default(true)     @map("all_day")    // 하루종일 여부

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  files TodoFile[]

  @@map("todos")
}

// 할일 첨부파일
model TodoFile {
  id        Int      @id @default(autoincrement())
  todoId    Int      @map("todo_id")
  filename  String   @db.VarChar(255)
  path      String   @db.VarChar(500)
  mimetype  String   @db.VarChar(100)
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@map("todo_files")
}

// AI 도구 가이드
model AiTool {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  content     String   @db.Text
  tags        String[]
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  authorId    Int      @map("author_id")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("ai_tools")
}

// 오늘의 각오
model DailyMotto {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  content   String   @db.VarChar(200)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_mottos")
}

// 개인 캘린더 일정
model CalendarEvent {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(200)
  date      DateTime @db.Date
  endDate   DateTime? @map("end_date") @db.Date          // 종료일 (없으면 date 단일 날짜)
  allDay    Boolean  @default(false) @map("all_day")     // 하루종일 여부
  startTime String?  @map("start_time") @db.VarChar(5)
  endTime   String?  @map("end_time") @db.VarChar(5)
  memo      String?  @db.Text
  location  String?  @db.VarChar(200)
  color     String   @default("#3b82f6") @db.VarChar(7)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

// 주식 뉴스 AI 분류 캐시
model StockNews {
  id          Int      @id @default(autoincrement())
  stockCode   String   @map("stock_code") @db.VarChar(10)
  stockName   String   @map("stock_name") @db.VarChar(50)
  title       String   @db.VarChar(300)
  summary     String   @db.VarChar(50)
  importance  String   @db.VarChar(10)
  sentiment   String   @default("neutral") @db.VarChar(10)
  reason      String   @db.VarChar(200)
  explain     String?  @db.Text
  url         String   @db.VarChar(500)
  publishedAt DateTime @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([stockCode, publishedAt])
  @@map("stock_news")
}

model StockNewsCacheLog {
  id        Int      @id @default(autoincrement())
  stockCode String   @unique @map("stock_code") @db.VarChar(10)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("stock_news_cache_log")
}

// 기분 트래커
model Mood {
  id        String   @id @default(uuid())
  date      String   // 'YYYY-MM-DD'
  mood      Int      // 1-5
  memo      String?  // 한줄 메모 (선택사항)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("moods")
}

// 운동 트래커
model Workout {
  id        String   @id @default(uuid())
  date      String
  name      String
  weight    Float?
  sets      Int?
  reps      Int?
  duration  Int?
  memo      String?
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workouts")
}

// 식사 트래커
model Meal {
  id        String   @id @default(uuid())
  date      String
  type      String
  content   String
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meals")
}



// 메모
model Memo {
  id        String    @id @default(uuid())
  title     String    @db.VarChar(100)
  content   String    @db.Text
  color     String    @default("yellow") @db.VarChar(20) // yellow|pink|blue|green|purple
  pinned    Boolean   @default(false)
  order     Int       @default(0)
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("memos")
}

// 카카오 OAuth 토큰
model KakaoToken {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  accessToken  String   @map("access_token") @db.Text
  refreshToken String   @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kakao_tokens")
}

// 매매일지
model TradeLog {
  id        String   @id @default(uuid())
  userId    Int      @map("user_id")
  stockName String   @map("stock_name") @db.VarChar(50)
  stockCode String   @map("stock_code") @db.VarChar(10)
  buyPrice  Int      @map("buy_price")         // 매수가
  targetPrice Int?   @map("target_price")       // 목표가
  stopLoss  Int?     @map("stop_loss")          // 손절가
  sellPrice Int?     @map("sell_price")          // 매도가 (청산 시)
  quantity  Int      @default(1)                 // 수량
  status    String   @default("holding") @db.VarChar(20) // holding|profit|stopped|watching
  buyDate   String   @map("buy_date")           // YYYY-MM-DD
  sellDate  String?  @map("sell_date")          // 청산일
  memo      String?  @db.Text
  strategy    String?  @db.VarChar(20)                         // morning_dip|breakout|pullback|earnings_news|impulse|unclassified
  realPnl     Int?     @map("real_pnl")                       // 실제 손익 (수수료/세금 포함)
  entryReason String? @map("entry_reason") @db.VarChar(200)  // 진입 사유
  exitReason  String? @map("exit_reason") @db.VarChar(200)   // 청산 사유
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("trade_logs")
}

// 기술 학습 노트
model TechNote {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(200)
  category  String   @db.VarChar(20)
  tags      String[]
  summary   String   @db.VarChar(500)
  content   String   @db.Text
  isPublic  Boolean  @default(false) @map("is_public") // true면 모든 로그인 사용자가 읽기 가능 (수정/삭제는 작성자만)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tech_notes")
}

// 유저 설정
model UserPreference {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  preferences Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// 시황 이벤트 결과 기록
model MarketEventResult {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique @map("event_id") @db.VarChar(100) // JSON의 id와 매칭
  actual    String?  @db.VarChar(100)  // 실제 결과
  memo      String?  @db.Text          // 메모
  impact    String?  @db.VarChar(20)   // above | meet | below (예상 대비)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("market_event_results")
}

// 시황 일지
model MarketJournal {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  date      String   @db.VarChar(10)   // "YYYY-MM-DD"
  content   String   @db.Text          // 마크다운 본문
  summary   String?  @db.VarChar(200)  // 한줄 요약
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("market_journals")
}

// 스마트스코어 일별 스냅샷
model ScoreSnapshot {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  date      String   @db.VarChar(10)   // "YYYY-MM-DD" (스코어 계산일)
  entryDate String?  @map("entry_date") @db.VarChar(10) // 진입기준일 (다음 거래일)
  data      Json     // [{code, name, theme, rank, total, supply, momentum, surge, valuation, entryPrice}]
  memo      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("score_snapshots")
}

// 스코어 검증 포트폴리오
model ScorePortfolio {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  initialCash  Int      @default(3000000) @map("initial_cash") // 초기 자금
  maxStocks    Int      @default(3) @map("max_stocks")          // 최대 보유 종목수
  maxHoldDays  Int      @default(20) @map("max_hold_days")      // 최대 보유일
  rules        String?  @db.Text                                 // 매매 규칙 메모
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades ScoreTrade[]

  @@map("score_portfolios")
}

// 스코어 검증 매매 기록
model ScoreTrade {
  id          Int      @id @default(autoincrement())
  portfolioId Int      @map("portfolio_id")
  stockCode   String   @map("stock_code") @db.VarChar(10)
  stockName   String   @map("stock_name") @db.VarChar(50)
  action      String   @db.VarChar(10) // buy | sell
  price       Int                       // 체결가
  quantity    Int                       // 수량
  scoreAtBuy  Int?     @map("score_at_buy")  // 매수 시점 스마트스코어
  reason      String?  @db.VarChar(200)       // 매매 사유
  date        String   @db.VarChar(10)        // YYYY-MM-DD
  createdAt   DateTime @default(now()) @map("created_at")

  portfolio ScorePortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("score_trades")
}

// 상영 캘린더 — KOBIS 영화 (크론 1일 1회 동기화, 프론트는 DB만 조회)
model Movie {
  id           Int       @id @default(autoincrement())
  movieCd      String    @unique @map("movie_cd")            // KOBIS 영화코드 (upsert 기준)
  movieNm      String    @map("movie_nm")                     // 한글 제목
  movieNmEn    String?   @map("movie_nm_en")                  // 영문 제목
  openDt       DateTime? @map("open_dt") @db.Date             // 개봉일 (캘린더 배치 기준, null이면 캘린더 제외)
  productionYear Int?    @map("production_year")              // KOBIS 제작연도
  isRerelease  Boolean   @default(false) @map("is_rerelease") // 재개봉 추정 여부
  prdtStatNm   String?   @map("prdt_stat_nm") @db.VarChar(20) // 제작상태 (개봉 / 개봉예정 등)
  genreNm      String?   @map("genre_nm") @db.VarChar(100)    // 장르 (상세 드로어용)
  nationNm     String?   @map("nation_nm") @db.VarChar(100)   // 제작국가 (상세 드로어용)
  directors    String?   @db.VarChar(200)                     // 감독명(들) 콤마 조인
  watchGradeNm String?   @map("watch_grade_nm") @db.VarChar(20) // 관람등급 (멜로+청불 성인물 판별용); KOBIS 상세 API로만 조회 가능
  gradeCheckedAt DateTime? @map("grade_checked_at")            // 관람등급 조회 시도 시각 (반복 호출 방지)
  tmdbId       Int?      @map("tmdb_id")
  overview     String?   @db.Text
  posterPath   String?   @map("poster_path")
  tmdbCheckedAt DateTime? @map("tmdb_checked_at")
  boxRank      Int?      @map("box_rank")                     // 최신 박스오피스 순위 (없으면 박스오피스 밖)
  audiCnt      Int?      @map("audi_cnt")                     // 박스오피스 기준일 관객수
  audiAcc      Int?      @map("audi_acc")                     // 누적 관객수
  boxUpdatedAt DateTime? @map("box_updated_at")               // 박스오피스 기준일
  syncedAt     DateTime  @default(now()) @map("synced_at")    // 마지막 동기화 시각
  createdAt    DateTime  @default(now()) @map("created_at")

  bookmarks MovieBookmark[]

  @@index([openDt])
  @@index([boxRank])
  @@map("movies")
}

model MovieBookmark {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  movieCd   String   @map("movie_cd")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieCd], references: [movieCd], onDelete: Cascade)

  @@unique([userId, movieCd])
  @@map("movie_bookmarks")
}

// 이슈 댓글
model IssueComment {
  id        Int      @id @default(autoincrement())
  issueId   Int      @map("issue_id")
  userId    Int      @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("issue_comments")
}
