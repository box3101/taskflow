generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 사용자
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("member") // admin | member
  createdAt DateTime @default(now()) @map("created_at")

  members  Member[]
  assigned Issue[]  @relation("assignee")
  todos    Todo[]
  aiTools  AiTool[]

  @@map("users")
}

// 프로젝트
model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String   @default("active") // active | done | hold
  createdAt   DateTime @default(now()) @map("created_at")

  members Member[]
  issues  Issue[]

  @@map("projects")
}

// 프로젝트 멤버
model Member {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  role      String   @default("dev") // owner | dev | viewer
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("members")
}

// 이슈
model Issue {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  assigneeId Int?     @map("assignee_id")
  title       String
  description String?
  status      String   @default("todo") // todo | doing | done
  priority    String   @default("mid")  // high | mid | low
  urgency     String   @default("normal") // urgent | high | normal | low
  requestedAt DateTime? @map("requested_at")
  dueAt       DateTime? @map("due_at")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("issues")
}

// 개인 할일
model Todo {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(500)
  done      Boolean  @default(false)
  priority  String   @default("none") // high | mid | low | none
  memo      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("todos")
}

// AI 도구 가이드
model AiTool {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  content     String   @db.Text
  tags        String[]
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  authorId    Int      @map("author_id")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("ai_tools")
}
