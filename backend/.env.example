DATABASE_URL="postgresql://postgres:1234@localhost:5432/taskflow"
JWT_SECRET="taskflow-dev-secret"
PORT=4000

# Average 원본 기록 연결 (읽기 전용). 해당 디렉터리와 Python이 서버에 있어야 합니다.
AVERAGE_ROOT=
AVERAGE_SPIKE_OWNER_ID=
## Railway에서는 클라우드 수집 기본 활성화, 조회 소유자는 FLOW_AUTO_USER_ID 사용 가능
## false로 명시하면 수집 중지. SPIKE_SOURCE=cloud는 저장된 클라우드 기록 조회.
SPIKE_CLOUD_ENABLED=
SPIKE_SOURCE=
PYTHON_BIN=python

# 대장 유지 모의 전략. 외부 알림/LLM은 명시적으로 켜기 전까지 호출하지 않습니다.
SURGE_ENABLED=false
SURGE_GATE_WON=10000000000
SURGE_STABLE_SECONDS=180
SURGE_COMPARISON_GATES=50000000000,100000000000
SURGE_TOP_THEMES=3
SURGE_MAX_ENTRIES=3
SURGE_START=09:05:00
SURGE_ENTRY_END=15:20:00
SURGE_CLOSE=15:30:00
SURGE_STOP_PCT=3
SURGE_COST_PCT=0.21
SURGE_INTERVAL_SECONDS=10
SURGE_BROAD_SECONDS=60
SURGE_HOT_LIMIT=60
SURGE_QUOTE_AGE_SECONDS=90
SURGE_EXECUTION_AGE_SECONDS=20
SURGE_MAX_GAP_SECONDS=30
SURGE_LIMIT_PCT=29.5
SURGE_SINGLETON=true
SURGE_LEGACY_ENABLED=true
SURGE_BASE_TOP=400
SURGE_HISTORY_YEARS=3
SURGE_HISTORY_MIN_WON=100000000000
SURGE_HISTORY_MIN_PCT=10
KRX_ID=
KRX_PW=
SURGE_BATCH_DELAY_SECONDS=1
SURGE_BATCH_TIMEOUT_MS=900000
SURGE_PREPARE_RETRY_MS=600000
SURGE_BACKFILL_DAYS=120
SURGE_WEB_SEARCH=true
SURGE_WEB_SEARCH_MAX_USES=5
SURGE_STATUS_ATTEMPTS=3
SURGE_STATUS_DELAY_MS=80
SURGE_NAVER_THEME_PAGES=20
SURGE_RANK_TARGET=200
SURGE_RANK_MAX_CALLS=7
SURGE_QUOTE_BATCH_SIZE=50

NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 비워두면 기본 게이트와 유지 시간으로 완전한 variant ID 생성
SURGE_NOTIFY_VARIANT=
SURGE_NOTIFY_STOP=false
SURGE_NOTIFY_CLOSE=false
SURGE_NOTIFY_BACKOFF_MS=1000
SURGE_NOTIFY_MAX_AGE_SECONDS=300

# Sonnet: 문서 요약만. 가격 시계열·매매 판단·테마 자동 적용 없음.
SURGE_LLM_ENABLED=false
SURGE_LLM_MODEL=claude-sonnet-5
SURGE_LLM_DAILY_LIMIT=10
SURGE_NEWS_LIMIT=5
# NAVER API HUB credentials (Ncloud), not NAVER Login/legacy Developers keys
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=

# 한국투자증권 실전 Open API — 서버에서만 사용 (주문 기능 없음)
KIS_APP_KEY=
KIS_APP_SECRET=
# 각 API 응답의 금액 단위를 HTS/문서와 대조한 뒤 지정: won / million / eok
# 비워두면 'API 원단위'로 표시. 잘못된 억원 환산을 방지합니다.
KIS_CASH_AMOUNT_UNIT=
KIS_PROGRAM_AMOUNT_UNIT=

# 기존 뉴스 분석용 Gemini
GEMINI_API_KEY=
# 수급 기본 판단: Claude Sonnet / 심층 검토·마감 복기: Claude Sonnet 또는 GPT Astra
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FLOW_BASIC_MODEL=claude-sonnet-5
# Railway 앱에만 활성화. 관리자 계정 ID를 지정. 09:15~15:00 15분 간격, 수급만 하루 최대 24회(실패 포함).
FLOW_AUTO_ENABLED=false
FLOW_AUTO_USER_ID=
FLOW_ASTRA_MODEL=gpt-6-astra

# KOBIS 오픈API (상영 캘린더 동기화 크론) — kobis.or.kr에서 무료 발급
KOBIS_API_KEY=

# TMDB API (상영 캘린더 포스터 이미지 — 향후 확장, 현재 미사용) — themoviedb.org에서 무료 발급
TMDB_API_KEY=

# Cloudflare R2 (없으면 로컬 디스크 모드)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
